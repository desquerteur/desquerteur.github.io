---
import type { Project } from '../data/projects';
import { statusLabel } from '../data/projects';
import { projectUrl, projectHost, SUBDOMAIN_MODE } from '../lib/urls';
interface Props { project: Project }
const { project: p } = Astro.props;
const thumbSrc = p.cover ?? p.shots?.[0]?.src ?? p.video?.poster;
const host = SUBDOMAIN_MODE ? projectHost(p.slug) : `/projects/${p.slug}/`;
---
<article class="embed reveal" style={`--c:${p.color}`}>
  <div class="body">
    <div class="top">
      <span class="mark" aria-hidden="true">{p.mark}</span>
      <span class="mono host">{host}</span>
    </div>
    <h3><a href={projectUrl(p.slug)} class="stretched">{p.name}</a></h3>
    <p class="tag">{p.tagline}</p>
    <div class="fields">
      <div>
        <span class="label">Status</span>
        <span class:list={['status', `status-${p.status}`]}>{statusLabel[p.status]}</span>
      </div>
      <div>
        <span class="label">Category</span>
        <span class="val">{p.category}</span>
      </div>
    </div>
    <ul class="chips">
      {p.stack.slice(0, 5).map((s) => <li class="chip">{s}</li>)}
    </ul>
  </div>
  {thumbSrc ? (
    <img class="thumb" src={thumbSrc} alt={`${p.name} preview`} loading="lazy" decoding="async" />
  ) : (
    <div class="thumb cover" aria-hidden="true"><span>{p.mark}</span></div>
  )}
</article>

<style>
  .embed {
    position: relative; display: flex; flex-direction: column;
    background: rgba(18, 13, 36, 0.78); backdrop-filter: blur(6px);
    border: 1px solid var(--border); border-left: 4px solid var(--c);
    border-radius: var(--r-card); overflow: hidden;
    transition: transform 220ms var(--ease), box-shadow 220ms var(--ease), border-color 160ms ease, opacity 600ms ease;
  }
  .embed:hover { transform: translateY(-3px); box-shadow: var(--lift); border-color: color-mix(in srgb, var(--c) 55%, transparent); border-left-color: var(--c); }
  .body { padding: var(--s-4) var(--s-5) var(--s-5); display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .top { display: flex; align-items: center; gap: 10px; }
  .mark { width: 30px; height: 30px; border-radius: 10px; display: grid; place-items: center; background: var(--c); color: #05030b; font: 700 0.75rem var(--font-head); flex: none; }
  .host { color: var(--faint); font-size: 0.75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  h3 { font-size: 1.25rem; }
  h3 a { color: var(--text); }
  .embed:hover h3 a { color: var(--c); }
  .stretched::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .tag { color: var(--muted); margin: 0; font-size: 0.95rem; }
  .fields { display: flex; gap: var(--s-6); flex-wrap: wrap; }
  .fields > div { display: flex; flex-direction: column; gap: 2px; }
  .val { font-size: 0.85rem; color: var(--text); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 4px 0 0; padding: 0; }
  .thumb { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-top: 1px solid var(--border); }
  .cover { display: grid; place-items: center; background:
      radial-gradient(50% 80% at 25% 20%, color-mix(in srgb, var(--c) 55%, transparent), transparent 70%),
      radial-gradient(40% 70% at 85% 90%, rgba(46, 230, 214, 0.25), transparent 70%),
      radial-gradient(1px 1px at 20% 30%, #fff, transparent), radial-gradient(1px 1px at 70% 20%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 40% 75%, #c4b5fd, transparent), radial-gradient(1px 1px at 85% 55%, #fff, transparent),
      #0b0817; }
  .cover span { font: 700 3.4rem var(--font-head); color: var(--c); text-shadow: 0 0 40px var(--c); letter-spacing: -0.04em; }
</style>
