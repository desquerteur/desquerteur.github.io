---
// The "d" monogram: a small planet with a turquoise ring.
interface Props { size?: number }
const { size = 44 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label="desquerteur">
  <defs>
    <linearGradient id="lg-planet" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a78bfa" />
      <stop offset="0.55" stop-color="#5865f2" />
      <stop offset="1" stop-color="#2ee6d6" />
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="24" fill="url(#lg-planet)" />
  <ellipse cx="32" cy="34" rx="31" ry="8" fill="none" stroke="#2ee6d6" stroke-width="2.5" opacity="0.85" transform="rotate(-18 32 34)" />
  <text x="32" y="41" text-anchor="middle" font-family="Space Grotesk Variable, sans-serif" font-weight="700" font-size="26" fill="#05030b">d</text>
</svg>
