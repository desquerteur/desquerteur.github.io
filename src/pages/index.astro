---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import EmbedCard from '../components/EmbedCard.astro';
import GithubIcon from '../components/GithubIcon.astro';
import { projects, featured, statusLabel } from '../data/projects';
import { projectUrl, projectHost, SUBDOMAIN_MODE } from '../lib/urls';

const stack = [
  { group: 'AI tooling', items: ['Claude Code', 'Codex', 'MCP servers', 'Agent skills', 'LM Studio'] },
  { group: 'Web & apps', items: ['React', 'TypeScript', 'Vite', 'Firebase', 'Astro'] },
  { group: 'Systems', items: ['Python', 'Kotlin', 'Java', 'C#', 'Docker', 'Linux'] },
  { group: 'Hardware', items: ['Raspberry Pi', 'ESP32-S3', 'KiCad', 'OBD-II', 'Fusion 360', '3D printing'] },
];
const ways = [
  {
    icon: '✦',
    title: 'AI is my team',
    text: 'I build with Claude Code and Codex like with a team of developers: I set the goal and the architecture, they write with me, and every result gets tested and reviewed before it ships.',
  },
  {
    icon: '◎',
    title: 'Real things, real hardware',
    text: 'My software runs in cars, on phones, on Minecraft servers and in restaurants – and some of it on circuit boards I design myself in KiCad.',
  },
  {
    icon: '➤',
    title: 'Shipped, not just started',
    text: 'Releases, installers, docs, screenshots and intro videos: a project is done when someone else can install it and understand it in a minute.',
  },
];
const hostOf = (slug: string) => (SUBDOMAIN_MODE ? projectHost(slug) : `/projects/${slug}/`);
---
<Base
  title="desquerteur – Noriel, 14-year-old developer"
  description="I'm Noriel, a 14-year-old developer from Austria building car software, Android apps, Minecraft plugins, restaurant platforms and circuit boards with Claude Code and Codex."
  channel="welcome"
  topic="Hi! This is where I introduce myself and everything I build."
>
  <section class="hero">
    <div class="hero-text reveal">
      <p class="label kicker"><span class="dot" aria-hidden="true"></span> online · building something</p>
      <h1>Hi, I'm <span class="gradient-text">Noriel</span>.</h1>
      <p class="lead">
        I'm a <strong>14-year-old developer</strong> from Austria. I build car software, Android apps,
        Minecraft plugins, a restaurant platform and my own circuit boards – mostly together with{' '}<strong>Claude Code</strong> and <strong>Codex</strong>.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#projects">Explore my projects</a>
        <a class="btn btn-ghost" href="https://github.com/desquerteur"><GithubIcon size={18} /> desquerteur</a>
      </div>
    </div>

    <aside class="profile reveal" aria-label="Profile card">
      <div class="banner"></div>
      <div class="avatar">
        <Logo size={92} />
        <span class="online" title="Online"></span>
      </div>
      <div class="pbody">
        <h2 class="pname">Noriel</h2>
        <p class="phandle mono">desquerteur</p>
        <ul class="badges">
          <li class="chip">⚡ Claude Code</li>
          <li class="chip">◆ Codex</li>
          <li class="chip">🎓 HTL student</li>
        </ul>
        <div class="pdiv"></div>
        <p class="label">About me</p>
        <p class="pabout">Developer &amp; maker from Austria. I like cars, Minecraft, hardware and making AI agents do real work.</p>
        <div class="pstats">
          <div><strong>{projects.length}</strong><span>projects</span></div>
          <div><strong>{projects.filter((p) => p.status === 'released').length}</strong><span>released</span></div>
          <div><strong>2023</strong><span>on GitHub since</span></div>
        </div>
      </div>
    </aside>
  </section>

  <section id="about" class="section">
    <div class="section-head reveal"><h2><span class="hash">#</span>about-me</h2></div>
    <div class="ways">
      {ways.map((w) => (
        <article class="way reveal">
          <span class="wicon" aria-hidden="true">{w.icon}</span>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="tour" class="section">
    <div class="section-head reveal">
      <h2><span class="hash">#</span>site-tour</h2>
      <span class="muted">42 seconds through this site and my projects.</span>
    </div>
    <video class="tour reveal" controls preload="none" playsinline poster="/videos/desquerteur-tour-poster.jpg" src="/videos/desquerteur-tour.mp4"></video>
  </section>

  <section id="projects" class="section">
    <div class="section-head reveal">
      <h2><span class="hash">#</span>featured-projects</h2>
      <span class="muted">Every project has its own page{SUBDOMAIN_MODE ? ' on its own subdomain' : ''}.</span>
    </div>
    <div class="grid">
      {featured.map((p) => <EmbedCard project={p} />)}
    </div>
  </section>

  <section id="project-file" class="section">
    <div class="section-head reveal">
      <h2><span class="hash">#</span>project-file</h2>
      <a href="/projects/" class="muted">Open the full project file →</a>
    </div>
    <ul class="channels reveal">
      {projects.map((p) => (
        <li>
          <a href={projectUrl(p.slug)} style={`--c:${p.color}`}>
            <span class="cmark" aria-hidden="true">{p.mark}</span>
            <span class="cname">{p.name}</span>
            <span class="ctag">{p.tagline}</span>
            <span class:list={['status', `status-${p.status}`]}>{statusLabel[p.status]}</span>
            <span class="chost mono">{hostOf(p.slug)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="stack" class="section">
    <div class="section-head reveal"><h2><span class="hash">#</span>tools-i-use</h2></div>
    <div class="stack reveal">
      {stack.map((s) => (
        <div class="sgroup">
          <p class="label">{s.group}</p>
          <ul>{s.items.map((i) => <li class="chip">{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="section contact reveal">
    <h2>Want to see more?</h2>
    <p>All my public code lives on GitHub. Stars, issues and pull requests are welcome.</p>
    <a class="btn btn-primary" href="https://github.com/desquerteur"><GithubIcon size={18} /> github.com/desquerteur</a>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.35fr 1fr; gap: var(--s-7); align-items: center; padding: var(--s-8) 0 var(--s-6); min-height: calc(92vh - 52px); }
  .kicker { display: inline-flex; align-items: center; gap: 8px; color: var(--teal); margin-bottom: var(--s-4); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal); box-shadow: var(--glow); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.4; } }
  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); font-weight: 700; letter-spacing: -0.03em; margin-bottom: var(--s-5); }
  .lead { font-size: 1.18rem; color: var(--muted); max-width: 36rem; }
  .lead strong { color: var(--text); font-weight: 600; }
  .cta { display: flex; gap: var(--s-3); flex-wrap: wrap; margin-top: var(--s-6); }

  .profile { background: rgba(11, 8, 23, 0.88); border: 1px solid var(--border); border-radius: var(--r-panel); overflow: hidden; box-shadow: var(--lift); backdrop-filter: blur(10px); max-width: 380px; justify-self: end; width: 100%; }
  .banner { height: 104px; background: radial-gradient(60% 120% at 20% 0%, #a78bfa, transparent 70%), radial-gradient(60% 120% at 90% 100%, #2ee6d6, transparent 70%), #5865f2; }
  .avatar { position: relative; width: 108px; height: 108px; margin: -54px 0 0 18px; border-radius: 50%; background: #0b0817; border: 6px solid #0b0817; display: grid; place-items: center; }
  .online { position: absolute; right: 2px; bottom: 6px; width: 22px; height: 22px; border-radius: 50%; background: var(--teal); border: 5px solid #0b0817; box-shadow: var(--glow); }
  .pbody { padding: var(--s-3) var(--s-5) var(--s-5); }
  .pname { font-size: 1.4rem; }
  .phandle { color: var(--muted); margin: 2px 0 var(--s-3); }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0; }
  .pdiv { height: 1px; background: var(--border); margin: var(--s-4) 0; }
  .pabout { font-size: 0.92rem; color: var(--text); margin: 4px 0 var(--s-4); }
  .pstats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .pstats div { background: var(--surface); border-radius: 8px; padding: 8px 10px; display: flex; flex-direction: column; }
  .pstats strong { font: 700 1.2rem var(--font-head); }
  .pstats span { font-size: 0.72rem; color: var(--muted); }

  .muted { color: var(--muted); font-size: 0.9rem; }
  .ways { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4); }
  .way { background: rgba(18, 13, 36, 0.7); border: 1px solid var(--border); border-radius: var(--r-card); padding: var(--s-5); }
  .wicon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--gradient); color: #05030b; font-size: 1.1rem; margin-bottom: var(--s-4); }
  .way h3 { font-size: 1.15rem; margin-bottom: var(--s-2); }
  .way p { color: var(--muted); margin: 0; font-size: 0.95rem; }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-5); }

  .channels { list-style: none; padding: 6px; margin: 0; background: rgba(11, 8, 23, 0.75); border: 1px solid var(--border); border-radius: var(--r-panel); }
  .channels a { display: grid; grid-template-columns: 34px minmax(140px, 220px) 1fr auto 210px; align-items: center; gap: var(--s-4); padding: 10px 12px; border-radius: 8px; color: var(--text); }
  .channels a:hover { background: var(--surface-2); }
  .cmark { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--c); color: #05030b; font: 700 0.72rem var(--font-head); transition: border-radius 220ms var(--ease); }
  .channels a:hover .cmark { border-radius: 10px; }
  .cname { font-weight: 600; }
  .ctag { color: var(--muted); font-size: 0.88rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .chost { color: var(--faint); font-size: 0.75rem; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .stack { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-4); }
  .sgroup ul { list-style: none; padding: 0; margin: var(--s-2) 0 0; display: flex; flex-wrap: wrap; gap: 6px; }

  .contact { text-align: center; padding-bottom: var(--s-8); }
  .contact h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: var(--s-3); }
  .contact p { color: var(--muted); }

  @media (max-width: 980px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .profile { justify-self: start; }
    .ways, .grid { grid-template-columns: 1fr; }
    .stack { grid-template-columns: repeat(2, 1fr); }
    .channels a { grid-template-columns: 34px 1fr auto; }
    .ctag, .chost { display: none; }
  }
  @media (max-width: 520px) {
    .stack { grid-template-columns: 1fr; }
  }
</style>
